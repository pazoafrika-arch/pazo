# ---- Server ----
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pazo
DB_POOL=10

# ---- Auth ----
# Replace both secrets before deploying anywhere real.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOGIN_LOCK_MINUTES=30

# ---- OTP ----
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
# Returns the OTP in the API response so the flow works without an SMS gateway.
# MUST be false in production.
OTP_DEV_ECHO=true

# ---- ClickPesa payment gateway ----
# From the ClickPesa developer portal. The account must have DISBURSEMENT
# (payout) enabled, not only collections.
CLICKPESA_BASE_URL=https://api.clickpesa.com/third-parties
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
# Enable checksums in the portal and paste the key here. Without it, inbound
# webhooks cannot be verified by signature and every callback has to be
# confirmed against the gateway before money moves.
CLICKPESA_CHECKSUM_KEY=
# Optional comma-separated allowlist of ClickPesa's webhook source IPs.
CLICKPESA_WEBHOOK_IPS=
